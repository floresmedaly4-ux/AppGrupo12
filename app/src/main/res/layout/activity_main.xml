<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APP GRUPO 12"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evaluación T1 - Aplicaciones Móviles"
                android:textSize="17sp"
                android:gravity="center"
                android:layout_marginBottom="30dp" />

            <Button
                android:id="@+id/btnPregunta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREGUNTA 1 - CONSUMO DE AGUA" />

            <Button
                android:id="@+id/btnPregunta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PREGUNTA 2 - ENERGÍA ELÉCTRICA" />

            <Button
                android:id="@+id/btnPregunta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PREGUNTA 3 - ESTACIONAMIENTO" />

            <Button
                android:id="@+id/btnPregunta4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PREGUNTA 4 - PLAN DE DATOS" />

            <Button
                android:id="@+id/btnPregunta5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PREGUNTA 5 - DESMONTE" />

            <Button
                android:id="@+id/btnPregunta6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PREGUNTA 6 - COWORKING" />

            <Button
                android:id="@+id/btnPregunta7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="PREGUNTA 7 - AGUAS RESIDUALES" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>